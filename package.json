{
  "name": "dayz-bean-launcher",
  "version": "1.5.0",
  "description": "The Best Community Launcher for DayZ",
  "author": {
    "name": "Dmitri",
    "email": "contact@dayzbeanslauncher.com"
  },
  "main": "dist-electron/electron/main.js",
  "homepage": "./",
  "license": "UNLICENSED",
  "scripts": {
    "ng": "ng",
    "start": "npm-run-all -p ng:serve electron:serve",
    "ng:serve": "ng serve",
    "electron:serve": "wait-on tcp:4200 && npm run electron:serve-tsc && npm run copy-loading && electron . --serve",
    "electron:serve-tsc": "tsc -p tsconfig.electron.json",
    "copy-loading": "node -e \"const fs=require('fs');const p=require('path');const srcHtml=p.join('src','electron','loading.html');const dstHtml=p.join('dist-electron','loading.html');const srcBg=p.join('src','assets','loading_logo.png');const dstBg=p.join('dist-electron','loading_logo.png');fs.mkdirSync(p.dirname(dstHtml),{recursive:true});fs.copyFileSync(srcHtml,dstHtml);fs.copyFileSync(srcBg,dstBg);console.log('Copied loading.html and background to dist-electron');\"",
    "build": "npm run build:angular:prod && npm run build:electron",
    "build:angular:dev": "ng build --configuration development",
    "build:angular:staging": "ng build --configuration staging",
    "build:angular:prod": "ng build --configuration production",
    "build:electron": "node scripts/set-build-env.js production && tsc -p tsconfig.electron.json && npm run copy-loading",
    "build:electron:staging": "node scripts/set-build-env.js staging && tsc -p tsconfig.electron.json && npm run copy-loading",
    "build:electron:watch": "tsc -p tsconfig.electron.json --watch",
    "copy-icons": "node -e \"const fs=require('fs');const p=require('path');fs.mkdirSync('build',{recursive:true});fs.copyFileSync('src/assets/dayz_beans_launcher.ico','build/icon.ico');console.log('✅ Icon copied to build/icon.ico');\"",
    "package": "npm run copy-icons && electron-builder",
    "package:win": "npm run copy-icons && electron-builder --win",
    "package:portable": "npm run copy-icons && electron-builder --win portable",
    "package:all": "npm run copy-icons && electron-builder --win --linux",
    "dist": "npm run build && npm run package",
    "dist:win": "npm run build && npm run package:win",
    "dist:portable": "npm run build && npm run package:portable",
    "clean": "node scripts/clean-safe.js",
    "prebuild": "npm run clean",
    "verify": "node scripts/verify-build.js",
    "postbuild": "npm run verify",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.html\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"src/**/*.html\" --fix",
    "lint:electron": "eslint \"src/electron/**/*.ts\"",
    "lint:electron:fix": "eslint \"src/electron/**/*.ts\" --fix",
    "core:boundary": "node scripts/check-core-public-boundary.js",
    "core:lockcheck": "node scripts/check-lockfile-platforms.js",
    "core:hashes": "node scripts/electron-hashes.js --dir dist-electron --out ELECTRON-HASHES.txt",
    "core:notices": "node scripts/generate-third-party-notices.js",
    "core:sync": "node scripts/sync-core-public.js"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "overrides": {
    "fast-xml-parser": "^5.5.10",
    "undici": "^7.29.0",
    "@hono/node-server": "^2.1.0"
  },
  "dependencies": {
    "@angular/animations": "^21.2.19",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-browser-dynamic": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@ngrx/store-devtools": "^21.1.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@sentry/angular": "^10.69.0",
    "@sentry/electron": "^7.16.0",
    "@stomp/stompjs": "^7.2.0",
    "@xhayper/discord-rpc": "^1.3.0",
    "axios": "^1.6.0",
    "dompurify": "^3.2.5",
    "electron-store": "^8.1.0",
    "electron-window-state": "^5.0.3",
    "flag-icons": "^7.5.0",
    "gamedig": "^5.3.2",
    "marked": "^17.0.1",
    "ping": "^0.4.4",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "steamworks.js": "^0.4.0",
    "zod": "^4.1.12",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular-eslint/builder": "^20.4.0",
    "@angular-eslint/eslint-plugin": "^20.4.0",
    "@angular-eslint/eslint-plugin-template": "^20.4.0",
    "@angular-eslint/schematics": "^20.4.0",
    "@angular-eslint/template-parser": "^20.4.0",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.19",
    "@types/dompurify": "^3.2.0",
    "@types/electron": "^1.4.38",
    "@types/gamedig": "^5.0.3",
    "@types/jasmine": "~5.1.0",
    "@electron/asar": "^3.4.1",
    "@types/node": "^20.0.0",
    "@types/ping": "^0.4.4",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "app-builder-bin": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.2",
    "eslint": "^9.38.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.3",
    "wait-on": "^7.0.0"
  }
}
